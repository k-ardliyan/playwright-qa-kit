{
  "name": "playwright-qa-kit",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Reusable Playwright E2E acceleration framework with interactive runner, page objects, custom reporting, and AI-assisted workflow support",
  "keywords": [
    "playwright",
    "e2e",
    "qa",
    "automation",
    "typescript",
    "page-object-model",
    "test-accelerator"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx validate-generated-tests.ts",
    "validate:requirement": "tsx validate-requirement.ts",
    "health:check": "tsx scripts/health-check-cli.ts",
    "install:mcp-server": "npm ci --prefix mcp-server",
    "prepare": "husky",
    "test": "npx playwright test --grep-invert @demo",
    "test:ci": "npm run test",
    "test:demo": "npx playwright test --project=demo --workers=1",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:property": "tsx scripts/run-property-tests.ts",
    "test:file-content": "tsx src/support/pw/__tests__/file-content-core.test.ts",
    "test:network-assert": "tsx src/support/pw/__tests__/network-assert-core.test.ts",
    "test:unit": "npx playwright test -c playwright.unit.config.ts",
    "sync:file-core": "tsx scripts/sync-file-content-core.ts",
    "mcp:build": "npm run install:mcp-server && npm run sync:file-core && npx tsc src/utils/app-env.ts src/utils/env-loader.ts src/utils/logger.ts --outDir src/utils --module commonjs --target es2020 --esModuleInterop --declaration --skipLibCheck --types node && cd mcp-server && npm run build",
    "mcp:typecheck": "npm run install:mcp-server && npx tsc -p mcp-server/tsconfig.json --noEmit",
    "xss:scan": "xss-scan",
    "quality:check-code": "npm run format:check && npm run lint && npm run typecheck && npm run mcp:typecheck && npm run xss:scan",
    "quality:check-rules": "npm run validate && npm run validate:requirement -- requirements/auth/sample-login-empty-fields.md && npm run test:property && npm run test:unit && npm run test:file-content && npm run test:network-assert",
    "test:quality": "npm run install:mcp-server && npm run setup:check && npm run quality:check-code && npm run quality:check-rules && npm run mcp:build && npm run health:check",
    "qa:run": "tsx scripts/qa-run.ts",
    "manual:check": "tsx scripts/manual-check.ts",
    "setup:wizard": "tsx src/setup/index.ts",
    "setup:check": "tsx src/setup/index.ts --check",
    "auth:setup": "npx playwright test src/support/auth.setup.ts --project=setup --workers=1",
    "env:edit": "tsx scripts/env-edit.ts",
    "env:status": "tsx scripts/env-status.ts",
    "env:use": "tsx scripts/env-use.ts",
    "archive:save": "tsx src/cli/archive-cli.ts save",
    "archive:view": "tsx src/cli/archive-cli.ts view",
    "archive:delete": "tsx src/cli/archive-cli.ts delete",
    "archive:compare": "tsx src/cli/archive-cli.ts compare",
    "dashboard:serve": "tsx src/cli/dashboard-server.ts --no-idle"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.17.4",
    "@eslint/js": "^10.0.1",
    "@kitajs/html": "^4.2.13",
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.19.43",
    "@types/prompts": "^2.4.9",
    "eslint": "^10.8.0",
    "eslint-plugin-playwright": "^2.10.5",
    "exceljs": "^4.4.0",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "image-size": "^2.0.2"
  }
}

# Salin → environments/local.env (jangan commit file berisi password nyata)
# Panduan: docs/GUIDE.md

# ⚠️  ENKRIPSI CREDENTIALS
# File ini adalah TEMPLATE. Salin ke environments/local.env lalu isi nilai asli.
# Setelah diisi, enkripsi dengan: npx @dotenvx/dotenvx encrypt -f environments/local.env
# Jangan pernah commit file .env berisi password/token dalam bentuk plaintext!
# Edit terenkripsi nanti: npm run env:edit

# ── URL Aplikasi ─────────────────────────────────────────────────
BASE_URL=http://localhost:3000/

# ── Nama Environment (logging) ───────────────────────────────────
ENV_NAME=local

# ── Kredensial QA (default user) ─────────────────────────────────
TEST_USER_EMAIL=test@example.com
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=your_password_here
# TEST_USER_PHONE=081234567890

# ── Kredensial per role (opsional, multi-role) ───────────────────
# Naming: {ROLE}_EMAIL / {ROLE}_PASSWORD  (ROLE = UPPER_SNAKE)
# Auth state: .auth/<role-kebab>.json
# Contoh:
# FINANCE_EMAIL=finance@example.com
# FINANCE_PASSWORD=your_password_here
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=your_password_here
# HRD_EMAIL=hrd@example.com
# HRD_PASSWORD=your_password_here
#
# Day-2 (ganti password / tambah / hapus role) — jangan edit ciphertext:
#   npm run env:edit
# Refresh session:
#   npx playwright test src/support/auth.setup.ts --project=setup
# Panduan: docs/CREDENTIALS.md

# ── Browser (opsional) ───────────────────────────────────────────
HEADLESS=true
SLOW_MO=0

# ── Playwright profile ───────────────────────────────────────────
# Path A (default — template core, spec di src/tests/):
PLAYWRIGHT_CONFIG=playwright.config.ts

# Path B (ERPKU adapter — spec di example/erpku/tests/):
# PLAYWRIGHT_CONFIG=example/erpku/playwright.config.ts
# Salin AUTH_* dan TEST_USER_PHONE dari example/erpku/environments/erpku.env.example ke file ini.
# Setelah ubah: restart MCP servers di IDE.

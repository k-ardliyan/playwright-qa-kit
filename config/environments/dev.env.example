# Salin → environments/dev.env · jalankan dengan APP_ENV=dev
# Panduan: docs/GUIDE.md + docs/CREDENTIALS.md

# ── URL Aplikasi ─────────────────────────────────────────────────
BASE_URL=https://dev.your-app.example.com/

# ── Role: user (default / mode general) ──────────────────────────
TEST_USER_EMAIL=test@example.com
TEST_USER_USERNAME=
TEST_USER_PHONE=
TEST_USER_PASSWORD=your_password_here
# TEST_USER_LOGIN_ID_PREF=email

# ── Multi-role (opsional, skema sama) ────────────────────────────
# FINANCE_EMAIL=
# FINANCE_USERNAME=
# FINANCE_PHONE=
# FINANCE_PASSWORD=
# FINANCE_LOGIN_ID_PREF=

# ── Browser ──────────────────────────────────────────────────────
HEADLESS=true
SLOW_MO=0

# ── Langkah tambahan login (OTP / CAPTCHA) — assisted, local only ─
# none | otp-browser | otp-stdin | captcha-browser | auto
AUTH_CHALLENGE_MODE=none
# AUTH_CHALLENGE_TIMEOUT_MS=180000
# AUTH_OTP_INPUT_SELECTOR=
# AUTH_OTP_SUBMIT_SELECTOR=
# otp-browser/captcha-browser → HEADLESS=false (wizard/env:edit)
# CI: AUTH_CHALLENGE_MODE=none

# ── Playwright profile ───────────────────────────────────────────
PLAYWRIGHT_CONFIG=playwright.config.ts

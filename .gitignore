# Dependencies
node_modules/

# Per-environment files (contain real credentials — never commit)
# Create environments/{local|dev|staging|production}.env with your credentials.
# Template examples (*.env.example) are tracked for reference.
environments/*.env
!environments/*.env.example

# Local active profile pin (written by npm run env:use)
environments/.active-env

# dotenvx keys
**/.env.keys
.env.keys

# Env edit / encrypt backups (may contain secrets)
*.env.bak
environments/*.bak
**/*.env.bak
**/*.bak

# Hermes agent local plans / cache (not part of release)
.hermes/

# Playwright artifacts
test-results/
playwright-report/
blob-report/

# Reports (generated)
reports/
!reports/.gitkeep

# Selector catalog (regenerable from snapshot_page / discover_pages MCP tools)
selector-catalog/
!selector-catalog/.gitkeep
!selector-catalog/.meta.json

# Logger output
logs/

# Auth state cache (login cookies/localStorage)
.auth/

# Property test transient artifacts
src/tests/__property_validator__/
src/tests/__property_capability__/
src/tests/__property_*/

# TypeScript
*.tsbuildinfo
mcp-server/dist/

# Local agent tooling (not part of release)
.agents/
.claude/

# Generated platform MCP configs (regenerable via `npm run mcp:config`)
claude_desktop_config.json
.cursor/mcp.json

# Generated capability manifest (regenerable via `npm run manifest:generate`)
agent-manifest.json

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
*.swp
*.swo
.vscode/settings.json

# Local debug / temp artifacts
debug-validator.ts
*.diff

# Compiled env loader for plain node execution in MCP server
src/utils/*.js
src/utils/*.d.ts

# Setup wizard state (per-machine, not tracked)
.wizard-state.json
